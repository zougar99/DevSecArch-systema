#!/bin/bash
#===============================================================================
# ForxoOS - Panic Wipe Script
# WARNING: This will DESTROY ALL DATA on the system!
#===============================================================================

set -euo pipefail

RED='\033[0;31m'
NC='\033[0m'

echo -e "${RED}"
echo "╔══════════════════════════════════════════════╗"
echo "║         PANIC WIPE ACTIVATED!                ║"
echo "║                                              ║"
echo "║   All data will be destroyed in 10 seconds!  ║"
echo "║   Press Ctrl+C to CANCEL                     ║"
echo "╚══════════════════════════════════════════════╝"
echo -e "${NC}"

for i in $(seq 10 -1 1); do
    echo -e "${RED}Wiping in ${i} seconds...${NC}"
    sleep 1
done

echo "Unmounting all partitions..."
umount -a 2>/dev/null || true

echo "Overwriting disk with random data..."
for disk in /dev/sd? /dev/nvme?n?; do
    if [ -b "$disk" ]; then
        echo "Wiping $disk..."
        dd if=/dev/urandom of="$disk" bs=1M count=100 conv=notrunc 2>/dev/null || true
        wipefs --all "$disk" 2>/dev/null || true
        sgdisk --zap-all "$disk" 2>/dev/null || true
    fi
done

echo "Syncing..."
sync

echo -e "${RED}SYSTEM WIPED! Shutting down...${NC}"
sleep 2
echo o > /proc/sysrq-trigger 2>/dev/null || poweroff -f
